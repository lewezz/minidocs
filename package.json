{
  "name": "minidocs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run tests/supabase.integration.test.ts",
    "test:lifecycle": "vitest run tests/document-lifecycle.integration.test.ts",
    "test:http": "node scripts/verify-http-actions.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.4",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
